# Copy this file to .env (local) or add the same two names in Vercel / Netlify > Environment Variables.
# Both values are in Supabase: Project Settings > API.
#
# BeiHub has NO demo mode: without these two values the site shows a setup screen,
# because all data (products, prices, contact details, orders) must live in Supabase
# so that every device sees the same thing.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER put the service_role key here. Anything starting with VITE_ is public in the browser.
